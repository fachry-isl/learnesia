# Public site URL (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://learnesia.co.id

# API Configuration
# Browser / client-side (host machine when using Docker Compose)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Server-side SSR inside Docker (Compose service name)
API_URL=http://backend:8000/api

# Security Obfuscation
NEXT_PUBLIC_ADMIN_PATH=/admin
NEXT_PUBLIC_ADMIN_SECRET_KEY=dev-secret-key
