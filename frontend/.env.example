# Public site URL (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://learnesia.co.id

# API Configuration
# Browser / client-side (host machine when using Docker Compose)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Server-side SSR inside Docker (service name varies by compose file)
# Dev:  http://backend-dev:8000/api  (docker-compose.yml)
# Prod: http://backend:8000/api      (docker-compose.prod.yml)
API_URL=http://backend-dev:8000/api

# Security Obfuscation
NEXT_PUBLIC_ADMIN_PATH=/admin
NEXT_PUBLIC_ADMIN_SECRET_KEY=dev-secret-key
